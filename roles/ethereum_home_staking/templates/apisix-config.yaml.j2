# {{ ansible_managed }}
#
# APISIX runs in file-driven standalone mode: routes and consumers are read from
# conf/apisix.yaml (templates/apisix-routes.yaml.j2). No etcd or Admin API is needed;
# Ansible is the only way to change the gateway's configuration.

apisix:
  node_listen:
    - 9080
  enable_dev_mode: false
  enable_reuseport: true
  enable_ipv6: {{ apisix_enable_ipv6 | default(true) | bool | lower }}

deployment:
  role: data_plane
  role_data_plane:
    config_provider: yaml

nginx_config:
  error_log: "/usr/local/apisix/logs/error.log"
  error_log_level: "warn"

plugin_attr:
  prometheus:
    export_addr:
      ip: "0.0.0.0"
      port: 9091
