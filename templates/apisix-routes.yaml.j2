# {{ ansible_managed }}
#
# APISIX standalone configuration for the Ethereum clients (conf/apisix.yaml).
#
# Authentication uses APISIX's built-in key-auth plugin. The multi-auth plugin
# accepts either of:
#   X-API-Key: <apisix_api_key>
#   Authorization: Bearer <apisix_bearer_token>
# Credentials are removed from the request before it reaches the clients.

consumers:
  - username: api_key_client
    plugins:
      key-auth:
        key: {{ apisix_api_key_resolved | to_json }}
  - username: bearer_token_client
    plugins:
      key-auth:
        key: {{ ('Bearer ' ~ apisix_bearer_token_resolved) | to_json }}

plugin_configs:
  - id: client-auth
    plugins:
      multi-auth:
        auth_plugins:
          - key-auth:
              header: X-API-Key
              hide_credentials: true
          - key-auth:
              header: Authorization
              hide_credentials: true

routes:
  # Execution client (Nethermind) JSON-RPC endpoint
  - id: execution-rpc
    name: "Execution RPC Endpoint"
    uri: /execution/*
    plugin_config_id: client-auth
    upstream:
      type: roundrobin
      nodes:
        "{{ execution_docker_container_name }}:{{ eth_ansible_execution_1_rpc_port }}": 1
      timeout:
        connect: 30
        send: 30
        read: 30
    plugins:
      proxy-rewrite:
        regex_uri:
          - "^/execution/(.*)"
          - "/$1"
      prometheus: {}

  # Consensus client HTTP API endpoint
  - id: consensus-api
    name: "Consensus API Endpoint"
    uri: /consensus/*
    plugin_config_id: client-auth
    upstream:
      type: roundrobin
      nodes:
        "{{ consensus_docker_container_name }}:{{ consensus_client_http_api_port }}": 1
      timeout:
        connect: 30
        send: 30
        read: 30
    plugins:
      proxy-rewrite:
        regex_uri:
          - "^/consensus/(.*)"
          - "/$1"
      prometheus: {}

  # Health check endpoint (no auth required)
  - id: health
    name: "Health Check"
    uri: /health
    upstream:
      type: roundrobin
      nodes:
        "{{ consensus_docker_container_name }}:{{ consensus_client_http_api_port }}": 1
    plugins:
      proxy-rewrite:
        uri: /eth/v1/node/health
      prometheus: {}

  # Execution health check (no auth required)
  - id: execution-health
    name: "Execution Health Check"
    uri: /execution-health
    upstream:
      type: roundrobin
      nodes:
        "{{ execution_docker_container_name }}:{{ eth_ansible_execution_1_rpc_port }}": 1
    plugins:
      proxy-rewrite:
        headers:
          set:
            Content-Type: application/json
      prometheus: {}

#END
